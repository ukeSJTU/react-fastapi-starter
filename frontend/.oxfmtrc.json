{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    "src/**/*.gen.ts",
    "src/api/generated/**"
  ],
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["cn", "cva"]
  }
}
